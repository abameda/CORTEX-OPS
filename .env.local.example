NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used solely by verified webhooks and the token-gated call start
# endpoint. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cal.com webhook verification
CAL_WEBHOOK_SECRET=
# Optional: reject signed deliveries older than this (default 86400 = 24h)
CAL_WEBHOOK_MAX_AGE_SECONDS=

# ElevenLabs transcript ingestion and private-agent call tokens
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Token-gated discovery calls
# Public URL of the marketing site's call page, e.g. https://cortex-pi-sable.vercel.app/call
CALL_PAGE_URL=
# Comma-separated browser origins allowed to start calls, e.g. https://cortex-pi-sable.vercel.app
CALL_ALLOWED_ORIGINS=

# Reserved for future direct execution mode
ANTHROPIC_API_KEY=
